# ── RONDA · configuración ───────────────────────────────────────────────
# Obligatoria (STT Whisper + LLM). Gratis en https://console.groq.com
GROQ_API_KEY=pega_aqui_tu_key

# Modelo permitido (compuerta G3). Sucesor vigente de Llama 3.1 70B en Groq,
# autorizado por la ficha técnica del reto. Si Groq lo renombra, actualiza aquí.
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=gemini

# Fallback opcional (también permitido): https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Voz del agente.
#   TTS_ENGINE=edge   siempre el motor remoto (voz colombiana)
#   TTS_ENGINE=piper  siempre el motor local (requiere requirements-voz-local.txt)
#   TTS_ENGINE=auto   usa TTS_PRIMARY y cae al otro motor si falla
# Por defecto: remoto por la voz colombiana, con respaldo local para que un
# corte del servicio externo no deje la llamada sin voz.
TTS_ENGINE=auto
TTS_PRIMARY=edge
TTS_VOICE=es-CO-SalomeNeural

# Embeddings. Para la ENTREGA FINAL se recomienda BAAI/bge-m3 (mejor español
# médico, ~2.3 GB de descarga la primera vez). Para desarrollo rápido:
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_MODEL=BAAI/bge-m3

# Umbral "cita o silencio" (distancia coseno máxima para aceptar evidencia)
RAG_MAX_DISTANCE=0.55

# Al caer el proveedor, el motor entra en modo degradado determinista.
# Ponlo en 1 solo si quieres que ademas intente el otro proveedor.
LLM_FALLBACK_A_PROVEEDOR=0

